# ==========================================
# CoPro Connect - Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# These variables are read by application.properties via ${VAR:default}.

# Server (optional)
SERVER_PORT=4000

# JWT - Generate a key: openssl rand -base64 64
JWT_SECRET=
# JWT_EXPIRATION=86400000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/copro-connect

# Mail (Brevo SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# MFA - Sender email address
MFA_SENDER_EMAIL=noreply@copro-connect.fr

# CORS - Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
